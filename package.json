{
  "name": "refboard",
  "productName": "RefBoard",
  "version": "0.4.0",
  "description": "PureRef 스타일 영상 레퍼런스 보드 - NAS(WebDAV)·로컬 폴더의 영상을 보드에 띄우고 Blender와 연결",
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "selftest": "electron . --selftest",
    "dist": "electron-builder --win nsis",
    "addon": "python scripts/make-addon-zip.py"
  },
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "fast-xml-parser": "^5.11.2"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0"
  },
  "author": "ddb27",
  "build": {
    "appId": "com.refboard.app",
    "productName": "RefBoard",
    "copyright": "Copyright (c) 2026 ddb27",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/icon.ico",
      "assets/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "RefBoard",
      "artifactName": "RefBoard-Setup-${version}.${ext}",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico"
    },
    "extraResources": [
      {
        "from": "blender/refboard_dock",
        "to": "blender-addon/refboard_dock",
        "filter": [
          "__init__.py"
        ]
      }
    ]
  }
}
